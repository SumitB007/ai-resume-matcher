# Server-side only: where the Next.js BFF/auth routes reach FastAPI.
# Local dev: the backend on :8000. Docker Compose sets this to http://api:8000.
API_INTERNAL_URL=http://localhost:8000

# Public site URL — inlined at build time for canonical URLs, OpenGraph,
# sitemap.xml and robots.txt. Set to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
