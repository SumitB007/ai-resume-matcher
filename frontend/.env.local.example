# Copy to .env.local for local (non-Docker) development.
# Server-side only: where Next.js route handlers reach the FastAPI backend.
# In Docker this is http://api:8000 (set in docker-compose.yml).
API_INTERNAL_URL=http://localhost:8000
# Browser-visible API origin (used only for display/links; app traffic goes
# through the /api/backend proxy so the JWT never touches browser JS).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
